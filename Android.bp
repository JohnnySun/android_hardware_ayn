cc_defaults {
    name: "ayn_host_test_defaults",
    cppflags: ["-fexceptions"],
}

cc_library_static {
    name: "libayn_rsinput_parser",
    srcs: ["src/rsinput_parser.cpp"],
    export_include_dirs: ["include"],
    host_supported: true,
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
    vendor_available: true,
}

cc_library_static {
    name: "libayn_rsinputd_core",
    srcs: [
        "src/rsinput_mapping.cpp",
        "src/rsinput_lifecycle.cpp",
        "src/rsinput_protocol.cpp",
    ],
    static_libs: ["libayn_rsinput_parser"],
    export_include_dirs: ["include"],
    host_supported: true,
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
    vendor_available: true,
}

cc_test_host {
    name: "ayn_rsinput_lifecycle_test",
    defaults: ["ayn_host_test_defaults"],
    srcs: ["tests/rsinput_lifecycle_test.cpp"],
    static_libs: ["libayn_rsinputd_core"],
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
    test_suites: ["general-tests"],
}

cc_binary {
    name: "rsinputd",
    srcs: ["src/rsinputd.cpp"],
    static_libs: [
        "libayn_rsinput_parser",
        "libayn_rsinputd_core",
    ],
    shared_libs: ["libbase"],
    init_rc: ["rsinputd.rc"],
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
}

cc_test_host {
    name: "ayn_rsinput_parser_test",
    defaults: ["ayn_host_test_defaults"],
