cc_binary {
    name: "rsinputd",
    srcs: ["src/rsinputd.cpp"],
    static_libs: [
        "libayn_controller_profile_adapter",
        "libayn_rsinput_parser",
        "libayn_rsinputd_core",
    ],
    shared_libs: [
        "com.ayn.controller-ndk",
        "libbase",
        "libbinder_ndk",
    ],
    init_rc: ["rsinputd.rc"],
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
}

