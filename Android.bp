cc_defaults {
    name: "ayn_host_test_defaults",
    cppflags: ["-fexceptions"],
}

aidl_interface {
    name: "com.ayn.fan",
    srcs: ["aidl/com/ayn/fan/*.aidl"],
    local_include_dir: "aidl",
    unstable: true,
    backend: {
        cpp: {
            enabled: false,
        },
        java: {
            enabled: true,
        },
        ndk: {
            enabled: true,
        },
        rust: {
            enabled: false,
        },
    },
}

aidl_interface {
    name: "com.ayn.controller",
    srcs: ["aidl/com/ayn/controller/*.aidl"],
    local_include_dir: "aidl",
    unstable: true,
    backend: {
        cpp: {
            enabled: false,
        },
        java: {
            enabled: true,
        },
        ndk: {
            enabled: true,
        },
        rust: {
            enabled: false,
        },
    },
}

cc_library_static {
    name: "libayn_rsinput_parser",
    srcs: ["src/rsinput_parser.cpp"],
    export_include_dirs: ["include"],
    host_supported: true,
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
    vendor_available: true,
}

cc_library_static {
    name: "libayn_rsinputd_core",
    srcs: [
        "src/controller_profile.cpp",
        "src/rsinput_mapping.cpp",
        "src/rsinput_lifecycle.cpp",
        "src/rsinput_poll.cpp",
        "src/rsinput_protocol.cpp",
        "src/rsinput_uart.cpp",
    ],
    static_libs: ["libayn_rsinput_parser"],
    export_include_dirs: ["include"],
    host_supported: true,
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
    vendor_available: true,
}

cc_library_static {
    name: "libayn_controller_profile_adapter",
    srcs: ["src/controller_profile_adapter.cpp"],
    static_libs: ["libayn_rsinputd_core"],
    export_include_dirs: ["include"],
    shared_libs: ["libbase"],
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
}

cc_test_host {
    name: "ayn_controller_profile_test",
    defaults: ["ayn_host_test_defaults"],
    srcs: ["tests/controller_profile_test.cpp"],
    static_libs: ["libayn_rsinputd_core"],
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
        "-pthread",
    ],
    ldflags: ["-pthread"],
    test_suites: ["general-tests"],
}

